# ===== CloudBase 云端环境（必填，否则无法连接数据库 / 登录）=====
# 环境 ID（CloudBase 控制台获取）
VITE_CLOUDBASE_ENV_ID=your-env-id
# 区域，默认上海
VITE_CLOUDBASE_REGION=ap-shanghai
# 发布密钥（Web 端访问密钥）
VITE_CLOUDBASE_PUBLISH_KEY=your-publish-key

# ===== 登录中继地址（Google 登录需要；留空则登录入口不可用）=====
VITE_OAUTH_RELAY_URL=https://your-oauth-relay.example.com

# ===== AI 文案生成（可选，不填则打卡页的「AI 建议」功能不可用）=====
# 兼容 /v1/chat/completions 的网关，默认 OpenAI
VITE_AI_BASE_URL=https://api.openai.com/v1
# 模型名，默认 gpt-4o-mini
VITE_AI_MODEL=gpt-4o-mini
# 调用密钥。
# 注意：VITE_ 前缀的变量会被打进浏览器包，任何访客都可提取，
# 请勿使用高权限或计费无上限的密钥。
VITE_AI_API_KEY=
